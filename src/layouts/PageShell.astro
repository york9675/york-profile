---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { appInfo } from '../data/app';
import { vercelToolbarConfig } from '../data/config';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description, lang = 'en' } = Astro.props;

const toolbarBranch = import.meta.env.VERCEL_GIT_COMMIT_REF ?? 'main';
const toolbarSrc = 'https://vercel.live/_next-live/feedback/feedback.js';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <script is:inline>
      try {
        const mode = localStorage.getItem('themeMode') || 'dark';
        if (mode === 'system') {
          if (window.matchMedia('(prefers-color-scheme: light)').matches) {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } else if (mode === 'light' || mode === 'newspaper') {
          document.documentElement.setAttribute('data-theme', mode);
        }
      } catch (_e) {  // eslint-disable-line @typescript-eslint/no-unused-vars
        // Silently ignore theme error
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <Analytics />
    <SpeedInsights />
    {appInfo.appEnv === 'development' && (
      <script
        is:inline
        define:vars={{
          toolbarSrc,
          toolbarBranch,
          toolbarOwnerId: vercelToolbarConfig.ownerId,
          toolbarProjectId: vercelToolbarConfig.projectId
        }}
      >
        window.addEventListener('load', () => {
          const toolbarScript = document.createElement('script');
          toolbarScript.src = toolbarSrc;
          toolbarScript.async = true;
          toolbarScript.dataset.explicitOptIn = 'true';
          toolbarScript.dataset.ownerId = toolbarOwnerId;
          toolbarScript.dataset.projectId = toolbarProjectId;
          toolbarScript.dataset.branch = toolbarBranch;

          const cleanupTimer = window.setTimeout(() => toolbarScript.remove(), 10_000);
          toolbarScript.addEventListener('load', () => window.clearTimeout(cleanupTimer), { once: true });
          toolbarScript.addEventListener('error', () => {
            window.clearTimeout(cleanupTimer);
            toolbarScript.remove();
          }, { once: true });

          document.body.append(toolbarScript);
        }, { once: true });
      </script>
    )}
  </body>
</html>
